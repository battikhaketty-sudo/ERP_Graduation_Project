VITE_API_BASE_URL=/api/v1
# Example: http://mag-erp-system.runasp.net
VITE_API_PROXY_TARGET=http://mag-erp-system.runasp.net

# Production (Netlify / static hosting):
# Keep VITE_API_BASE_URL=/api/v1 and use _redirects or netlify.toml to proxy /api/* to the backend.
# Alternative without proxy: set full URL, e.g. VITE_API_BASE_URL=https://mag-erp-system.runasp.net/api/v1
# (requires CORS enabled on the backend for your domain)
